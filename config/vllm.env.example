# Copy to .env for the launch script or to /etc/qwen3.8-vllm.env for systemd.
MODEL_PATH=/opt/models/Qwen3.8-27B-Uncensored-OrcaRouter-FP8/FP8
SERVED_MODEL_NAME=qwen-local
HOST=0.0.0.0
PORT=8000
VLLM_PYTHON=/opt/venvs/vllm-0271-qwopus/bin/python
FLASHQLA_PATH=/opt/src/FlashQLA-SM70-SM75
CHAT_TEMPLATE=/opt/qwen3-8-27b-dual-2080ti-vllm/templates/qwen3.8-froggeric-v22.3.jinja
CUDA_HOME=/usr/local/cuda
OMP_NUM_THREADS=8
VLLM_USE_DEEP_GEMM=0
VLLM_USE_FLASHINFER_SAMPLER=0
VLLM_QWOPUS_MTP_BF16_DRAFT=1
VLLM_SM75_SPEC_SYNC_MODE=safe
VLLM_USE_V2_MODEL_RUNNER=1

